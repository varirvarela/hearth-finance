{
  "rules": {
    ".read":  false,
    ".write": false,

    "accounts": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('partnerUid').val() === $uid || root.child('users').child(auth.uid).child('householdId').val() === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "transactions": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('partnerUid').val() === $uid || root.child('users').child(auth.uid).child('householdId').val() === $uid)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('householdId').val() === $uid)"
      }
    },
    "budgets": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('partnerUid').val() === $uid || root.child('users').child(auth.uid).child('householdId').val() === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rules": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('householdId').val() === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "suggestions": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "merchantRules": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('partnerUid').val() === $uid)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$code": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },
    "pendingInvites": {
      "$emailKey": {
        ".read":  "auth != null && auth.uid === data.child('ownerUid').val()",
        ".write": "auth != null && (auth.uid === data.child('ownerUid').val() || !data.exists())"
      }
    },
    "households": {
      "$ownerUid": {
        ".read":  "auth != null && (auth.uid === $ownerUid || root.child('users').child(auth.uid).child('householdId').val() === $ownerUid)",
        ".write": "auth != null && auth.uid === $ownerUid",
        "members": {
          "$memberUid": {
            ".write": "auth != null && (auth.uid === $ownerUid || auth.uid === $memberUid)"
          }
        }
      }
    },
    "categoryDescriptions": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "customCategories": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "_dev": {
      "accounts": {
